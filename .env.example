# openclaw-skills — Required Environment Variables
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. NEVER commit `.env` with real secrets.
#
# This list is the authoritative source for which env vars each skill expects.
# When a script says "missing X env var", that's the name to set here.

# ─── Plex / Tautulli (plex, plex-stats, deluge-cleanup) ───────────────────────
PLEX_URL=http://10.0.0.100:32400
PLEX_TOKEN=
TAUTULLI_URL=http://10.0.0.100:8181
TAUTULLI_API_KEY=
TMDB_API_KEY=                      # TheMovieDB API key (optional for some commands)

# ─── Sonarr / Radarr (deluge-cleanup) ─────────────────────────────────────────
SONARR_URL=http://10.0.0.100:8989/sonarr
SONARR_KEY=
RADARR_URL=http://10.0.0.100:7878/radarr
RADARR_KEY=

# ─── Deluge (deluge, deluge-cleanup, prowlarr) ───────────────────────────────
DELUGE_URL=http://10.0.0.100:8112
DELUGE_PASSWORD=                   # primary name; legacy alias DELUGE_PASS also accepted
# DELUGE_PASS=                      # uncomment if you only have the old name set

# ─── Prowlarr (prowlarr) ──────────────────────────────────────────────────────
PROWLARR_URL=http://10.0.0.100:9696/prowlarr
PROWLARR_API_KEY=

# ─── Cloudflare (cloudflare) ──────────────────────────────────────────────────
CF_ACCOUNT_ID=
CF_API_TOKEN_PHATT_TECH=            # https://dash.cloudflare.com/profile/api-tokens

# ─── Namecheap (namecheap-cli) ────────────────────────────────────────────────
NAMECHEAP_API_KEY=
NAMECHEAP_API_USER=phatt            # your Namecheap account username

# ─── Ghost CMS (ghost, ghost-wizarr) ──────────────────────────────────────────
# Admin key in `id:hex_secret` format (one value, splits on `:` internally)
GHOST_ADMIN_API_KEY=
GHOST_CONTENT_API_KEY=
GHOST_URL=https://phattmedia.club    # override only for non-prod Ghost

# ─── Resend email (resend) ────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── ElevenLabs TTS (podcast-gen, podcast-gen-vacation) ──────────────────────
ELEVENLABS_API_KEY=

# ─── LiteLLM (litellm skill; PHATT-RAID internal proxy) ───────────────────────
LITELLM_URL=http://10.0.0.100:4000
LITELLM_KEY=                        # primary name; legacy alias LITELLM_API_KEY also accepted
# LITELLM_API_KEY=                  # uncomment if you only have the old name set
# The Anthropic OAuth token at the proxy uses $LITELLM_KEY above — DO NOT
# also set ANTHROPIC_API_KEY for the litellm skill. Use the proxy.

# ─── Microsoft Graph (ms-graph) ──────────────────────────────────────────────
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# ─── Crawl4AI (crawl4ai) ──────────────────────────────────────────────────────
CRAWL4AI_URL=http://crawl4ai:11235
CRAWL4AI_API_TOKEN=                 # required, no default
CRAWL4AI_PROXY=http://10.0.0.100:8118

# ─── Pax8 (pax8) ─────────────────────────────────────────────────────────────
PAX8_CLIENT_ID=
PAX8_CLIENT_SECRET=

# ─── Apple Business Manager (apple-business-manager) ─────────────────────────
ABM_KEY_ID=
ABM_CLIENT_ID=
ABM_ISSUER_ID=
ABM_PRIVATE_KEY=                    # PEM contents (or path via ABM_PRIVATE_KEY_PATH)

# ─── Suno (suno-api-private, suno-creator) ────────────────────────────────────
SUNO_COOKIE=                        # Clerk JWT in `__session=...; __client=...; ajs_anonymous_id=...` format

# ─── Twitter / X (twitter-cli) ────────────────────────────────────────────────
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# ─── Mercury Bank (mercury-bank) ─────────────────────────────────────────────
MERCURY_API_KEY=                    # full token, includes `secret-token:` prefix
