<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>
    <meta name="description" content="{{meta_description}}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: #0a0a0a; color: #e0e0e0; line-height: 1.8; }
        a { color: #D4A847; text-decoration: none; }
        a:hover { color: #f0c96b; }
        .site-header { background: #111; border-bottom: 1px solid #222; padding: 20px 0; }
        .site-header .container { display: flex; align-items: center; gap: 15px; }
        .site-header img { height: 40px; border-radius: 4px; }
        .site-header h1 { font-size: 1.2rem; font-weight: 700; color: #D4A847; }
        .container { max-width: 720px; margin: 0 auto; padding: 0 20px; }
        article { padding: 40px 0; }
        article h1 { font-size: 2rem; margin-bottom: 15px; line-height: 1.3; }
        article img { max-width: 100%; border-radius: 6px; margin: 20px 0; }
        article p { margin-bottom: 1.5em; }
        article h2, article h3 { margin: 1.5em 0 0.5em; }
        article ul, article ol { margin: 0 0 1.5em 1.5em; }
        article blockquote { border-left: 3px solid #D4A847; padding-left: 20px; margin: 1.5em 0; color: #aaa; }
        .post-meta { color: #666; font-size: 0.9rem; margin-bottom: 30px; padding-bottom: 20px; border-bottom: 1px solid #222; }
        .post-meta img { width: 24px; height: 24px; border-radius: 50%; vertical-align: middle; margin-right: 8px; }
        .kg-width-wide { max-width: 100%; }
        .kg-width-full { max-width: 100%; width: 100%; }
        .kg-image-card { margin: 2em 0; }
        .kg-image-card figcaption { text-align: center; color: #666; font-size: 0.85rem; margin-top: 8px; }
        footer { text-align: center; padding: 40px 0; color: #444; font-size: 0.85rem; border-top: 1px solid #1a1a1a; margin-top: 40px; }
    </style>
    {{ghost_head}}
</head>
<body>
    <header class="site-header">
        <div class="container">
            {{#if @site.icon}}<img src="{{@site.icon}}" alt="{{@site.title}}">{{/if}}
            <h1><a href="{{@site.url}}">{{@site.title}}</a></h1>
        </div>
    </header>

    <main class="container">
        <article>
            {{#if feature_image}}
            <img src="{{feature_image}}" alt="{{title}}">
            {{/if}}
            <h1>{{title}}</h1>
            <div class="post-meta">
                {{#if author.profile_image}}<img src="{{author.profile_image}}" alt="{{author.name}}">{{/if}}
                <span>{{author.name}}</span> · <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM D, YYYY"}}</time>
                {{#if reading_time}} · {{reading_time}} min read{{/if}}
            </div>
            {{content}}
        </article>
    </main>

    <footer>
        <div class="container">
            &copy; {{date format="YYYY"}} {{@site.title}}. All rights reserved.
        </div>
    </footer>
    {{ghost_foot}}
</body>
</html>
